# ATLAS backend configuration. Copy to `.env` and adjust.
# All variables are prefixed with ATLAS_.

# --- App ---
ATLAS_APP_NAME=ATLAS
ATLAS_ENVIRONMENT=development
ATLAS_HOST=0.0.0.0
ATLAS_PORT=8000
ATLAS_LOG_LEVEL=INFO

# --- Persistence ---
# Async SQLAlchemy URL. Data files live under ATLAS_DATA_DIR.
ATLAS_DATA_DIR=./data
ATLAS_DATABASE_URL=sqlite+aiosqlite:///./data/atlas.db

# --- LLM (Ollama by default; use `echo` for dev/CI without a model) ---
ATLAS_LLM_PROVIDER=ollama
ATLAS_LLM_MODEL=qwen2.5:7b-instruct
ATLAS_LLM_BASE_URL=http://localhost:11434
ATLAS_LLM_TEMPERATURE=0.0
ATLAS_LLM_TIMEOUT_SECONDS=120

# --- Agent (M2: executor ReAct loop) ---
# Max executor iterations per goal, and JSON-repair attempts per turn.
ATLAS_AGENT_MAX_ITERATIONS=5
ATLAS_AGENT_REPAIR_ATTEMPTS=2

# --- Planner / context (M3) ---
# Hard cap on the planned task list; per prior-task output budget (chars) when
# composing a later task's context; force synthesis even for single-task plans.
ATLAS_AGENT_MAX_TASKS=5
ATLAS_CONTEXT_PRIOR_OUTPUT_CHARS=600
ATLAS_AGENT_FORCE_SYNTHESIS=false

# --- Self-correction (M4, RFC-0002) ---
# Master switch for the reflect -> retry/replan/abort loop. Defaults to false
# (M3 behavior). Retries are per task (attempts = retries + 1); replans per run.
# Model/tool call caps bound total work per run. Below the min confidence a
# retry/replan verdict downgrades to accept (0.0 disables the gate).
ATLAS_AGENT_ENABLE_REFLECTION=false
ATLAS_AGENT_MAX_RETRIES=2
ATLAS_AGENT_MAX_REPLANS=1
ATLAS_AGENT_MAX_MODEL_CALLS=60
ATLAS_AGENT_MAX_TOOL_CALLS=40
ATLAS_AGENT_REFLECTION_MIN_CONFIDENCE=0.0

# --- Episodic memory (M5, RFC-0003) ---
# Master switch for long-term memory. Defaults to false → byte-for-byte M4. When
# enabled, finished runs are distilled into lessons and recalled at plan time.
ATLAS_MEMORY_ENABLED=false
# Recall: max lessons injected, their total char budget, and the min relevance
# (fraction of goal terms matched) to inject. k=0 disables recall, keeps writing.
ATLAS_MEMORY_RECALL_K=3
ATLAS_MEMORY_RECALL_CHAR_BUDGET=800
ATLAS_MEMORY_RECALL_MIN_SCORE=0.15
# Store bound + expiry: prune keeps at most max_records active memories and
# hard-deletes rows soft-expired longer than expiry_days.
ATLAS_MEMORY_MAX_RECORDS=500
ATLAS_MEMORY_EXPIRY_DAYS=90
# Distill with an LLM call (false = zero-LLM heuristic); skip runs below min_tasks;
# which outcomes get written (comma-separated).
ATLAS_MEMORY_DISTILL_WITH_LLM=true
ATLAS_MEMORY_MIN_TASKS=1
ATLAS_MEMORY_WRITE_OUTCOMES=done,partial

# --- Tools (M2) ---
# Path jail for file_read / file_write. All file access is confined here.
ATLAS_WORKSPACE_DIR=./data/workspace
ATLAS_TOOL_TIMEOUT_SECONDS=30
ATLAS_WEB_SEARCH_MAX_RESULTS=5
ATLAS_WEB_FETCH_MAX_CHARS=2000

# --- Observability (M6, RFC-0004) ---
# Passive, best-effort, off by default → byte-for-byte M5. metrics_enabled turns
# on the in-process metrics registry and the /metrics endpoint (Prometheus text
# format); log_format selects the text (default) or opt-in JSON log formatter.
ATLAS_METRICS_ENABLED=false
ATLAS_LOG_FORMAT=text
# recovery_enabled (default on) reconciles runs left non-terminal by a crash to a
# terminal state at startup (a no-op on a clean DB). db_integrity_check runs
# PRAGMA quick_check at startup and fails fast on corruption (default off).
ATLAS_RECOVERY_ENABLED=true
ATLAS_DB_INTEGRITY_CHECK=false

# --- CORS (comma-separated origins for the frontend) ---
ATLAS_CORS_ORIGINS=http://localhost:3000
