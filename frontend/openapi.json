{
  "components": {
    "schemas": {
      "CreateRunRequest": {
        "description": "Payload for ``POST /runs``.",
        "properties": {
          "goal": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          }
        },
        "required": [
          "goal"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "Event": {
        "description": "A single, persisted, replayable event in a run's ledger.",
        "properties": {
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "seq": {
            "description": "Monotonic per-run sequence, starts at 1.",
            "minimum": 1.0,
            "title": "Seq",
            "type": "integer"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          }
        },
        "required": [
          "run_id",
          "seq",
          "type"
        ],
        "title": "Event",
        "type": "object"
      },
      "EventType": {
        "description": "Canonical event type names.\n\nGrouped by lifecycle stage. Milestone in which each is first emitted is\nnoted so later milestones extend rather than rewrite this enum.",
        "enum": [
          "run.created",
          "run.started",
          "run.completed",
          "run.failed",
          "run.cancelled",
          "answer.token",
          "answer.completed",
          "log",
          "thought",
          "tool.call",
          "tool.result",
          "plan.created",
          "task.started",
          "task.completed",
          "task.failed",
          "task.reflected",
          "task.retrying",
          "task.skipped",
          "task.cancelled",
          "plan.replanned",
          "budget.exceeded",
          "memory.recalled",
          "memory.written"
        ],
        "title": "EventType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthView": {
        "description": "Payload for ``GET /health``.",
        "properties": {
          "app": {
            "title": "App",
            "type": "string"
          },
          "llm_provider": {
            "title": "Llm Provider",
            "type": "string"
          },
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "time": {
            "format": "date-time",
            "title": "Time",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "app",
          "version",
          "llm_provider"
        ],
        "title": "HealthView",
        "type": "object"
      },
      "MemoryOutcome": {
        "description": "How the run a memory was distilled from ended.",
        "enum": [
          "done",
          "partial",
          "failed",
          "cancelled"
        ],
        "title": "MemoryOutcome",
        "type": "string"
      },
      "MemorySource": {
        "description": "How a memory's summary/lessons were produced.",
        "enum": [
          "synthesized",
          "heuristic"
        ],
        "title": "MemorySource",
        "type": "string"
      },
      "MemoryStatus": {
        "description": "Lifecycle status; ``expired`` is a soft-delete awaiting hard prune.",
        "enum": [
          "active",
          "expired"
        ],
        "title": "MemoryStatus",
        "type": "string"
      },
      "MemoryView": {
        "description": "A persisted memory as returned by the store and the API.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "goal": {
            "title": "Goal",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_recalled_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Recalled At"
          },
          "lessons": {
            "default": "",
            "title": "Lessons",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/MemoryOutcome"
          },
          "pinned": {
            "default": false,
            "title": "Pinned",
            "type": "boolean"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "salience": {
            "default": 1.0,
            "title": "Salience",
            "type": "number"
          },
          "source": {
            "$ref": "#/components/schemas/MemorySource",
            "default": "synthesized"
          },
          "status": {
            "$ref": "#/components/schemas/MemoryStatus",
            "default": "active"
          },
          "success": {
            "default": false,
            "title": "Success",
            "type": "boolean"
          },
          "summary": {
            "default": "",
            "title": "Summary",
            "type": "string"
          },
          "task_count": {
            "default": 0,
            "title": "Task Count",
            "type": "integer"
          },
          "tools_used": {
            "items": {
              "type": "string"
            },
            "title": "Tools Used",
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "use_count": {
            "default": 0,
            "title": "Use Count",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "goal",
          "outcome",
          "created_at",
          "updated_at"
        ],
        "title": "MemoryView",
        "type": "object"
      },
      "RunStatus": {
        "description": "Run-level FSM (design doc \u00a74): 6 states.\n\nCREATED \u2192 PLANNING \u2192 RUNNING \u2192 DONE, with terminal FAILED / CANCELLED and a\nRUNNING \u21c4 PAUSED loop. M1 uses CREATED \u2192 RUNNING \u2192 DONE/FAILED/CANCELLED.",
        "enum": [
          "created",
          "planning",
          "running",
          "paused",
          "done",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "RunSummary": {
        "description": "Compact run row for the History list (``GET /runs``).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "goal": {
            "title": "Goal",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          }
        },
        "required": [
          "id",
          "goal",
          "status",
          "created_at"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "RunView": {
        "description": "Serialized run as returned by the API.\n\n``partial`` (M4) is a derived read-only flag: True when a run finalized\n``FAILED`` yet still carries a synthesized answer \u2014 i.e. a graceful abort\nproduced a best-effort partial answer (RFC-0002 ADR-0014). Additive; defaults\nto False so existing consumers are unaffected.",
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "goal": {
            "title": "Goal",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "partial": {
            "default": false,
            "title": "Partial",
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "goal",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "RunView",
        "type": "object"
      },
      "TaskStatus": {
        "description": "Task-level FSM (design doc \u00a74). Declared now; exercised from M3.\n\nM4 (RFC-0002) exercises ``RETRYING`` (a task awaiting its next attempt after\na ``retry`` verdict) and ``CANCELLED`` (a non-terminal task stopped by run\ncancellation).",
        "enum": [
          "pending",
          "running",
          "retrying",
          "done",
          "failed",
          "skipped",
          "cancelled"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "TaskView": {
        "description": "A persisted task as returned by the API and carried through the runtime.",
        "properties": {
          "attempt_count": {
            "default": 0,
            "title": "Attempt Count",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "parent_generation": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Generation"
          },
          "replan_generation": {
            "default": 0,
            "title": "Replan Generation",
            "type": "integer"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "success_criteria": {
            "default": "",
            "title": "Success Criteria",
            "type": "string"
          },
          "suggested_tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Tool"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "run_id",
          "index",
          "description",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "TaskView",
        "type": "object"
      },
      "ToolSpec": {
        "description": "A tool's public contract, surfaced to the model and the ``GET /tools`` API.",
        "properties": {
          "args_schema": {
            "additionalProperties": true,
            "title": "Args Schema",
            "type": "object"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "args_schema"
        ],
        "title": "ToolSpec",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Agentic AI runtime \u2014 plan, act, reflect, recover.",
    "title": "ATLAS API",
    "version": "0.7.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/memories": {
      "get": {
        "description": "List memories newest-first, or relevance-ranked when ``q`` is given.",
        "operationId": "list_memories_memories_get",
        "parameters": [
          {
            "description": "Full-text search over memories",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Full-text search over memories",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MemoryView"
                  },
                  "title": "Response List Memories Memories Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Memories",
        "tags": [
          "memory"
        ]
      }
    },
    "/memories/{memory_id}": {
      "delete": {
        "description": "Forget a memory (privacy purge, RFC-0003 \u00a714).",
        "operationId": "delete_memory_memories__memory_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "memory_id",
            "required": true,
            "schema": {
              "title": "Memory Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Memory",
        "tags": [
          "memory"
        ]
      },
      "get": {
        "operationId": "get_memory_memories__memory_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "memory_id",
            "required": true,
            "schema": {
              "title": "Memory Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Memory",
        "tags": [
          "memory"
        ]
      }
    },
    "/memories/{memory_id}/pin": {
      "post": {
        "description": "Pin a memory so it is never pruned and is recall-preferred.",
        "operationId": "pin_memory_memories__memory_id__pin_post",
        "parameters": [
          {
            "in": "path",
            "name": "memory_id",
            "required": true,
            "schema": {
              "title": "Memory Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pin Memory",
        "tags": [
          "memory"
        ]
      }
    },
    "/memories/{memory_id}/unpin": {
      "post": {
        "operationId": "unpin_memory_memories__memory_id__unpin_post",
        "parameters": [
          {
            "in": "path",
            "name": "memory_id",
            "required": true,
            "schema": {
              "title": "Memory Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Unpin Memory",
        "tags": [
          "memory"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Prometheus-format metrics (RFC-0004 \u00a729), gated by ``ATLAS_METRICS_ENABLED``.\n\nReturns 404 when disabled so a scraper sees a clean off-state and enabling the\nendpoint changes no run behavior (invariant I-23). The WS-subscriber gauge is a\npull metric, sampled from the hub at scrape time.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics",
        "tags": [
          "system"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness probe (RFC-0004 \u00a728): can the service actually serve a run?\n\nRead-only and best-effort \u2014 it verifies the database is reachable, whether the\nFTS5 index is present (memory recall degrades to a LIKE scan otherwise), and\nthat a provider is configured. Returns 200 when ready, 503 otherwise. Distinct\nfrom ``/health`` (liveness), which only reports the process is up.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "system"
        ]
      }
    },
    "/runs": {
      "get": {
        "operationId": "list_runs_runs_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunSummary"
                  },
                  "title": "Response List Runs Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Runs",
        "tags": [
          "runs"
        ]
      },
      "post": {
        "operationId": "create_run_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}": {
      "get": {
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}/cancel": {
      "post": {
        "operationId": "cancel_run_runs__run_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Cancel Run Runs  Run Id  Cancel Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
